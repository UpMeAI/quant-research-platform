# Install as /home/kayla/.config/ops-env/qrp-research-web.env, mode 0600.
# Names and non-secret paths only. This pre-switch example is edge/upload OFF.
QRP_WEB_MODE=PRE_SWITCH_COMPARE
QRP_WEB_UPLOAD=OFF
QRP_ROOT=/srv/research-lane/qrp/code/REPLACE_WITH_64_HEX_SHA
