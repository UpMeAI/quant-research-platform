# Install as /home/kayla/.config/ops-env/qrp-tunnel.env, mode 0600.
# Edge remains OFF until the Owner has created the tunnel and Owner-only Access.
QRP_WEB_EDGE=OFF
QRP_CLOUDFLARED_VERSION=REPLACE_WITH_VERSION
QRP_CLOUDFLARED_BIN=/srv/research-lane/tools/cloudflared-REPLACE_WITH_VERSION/cloudflared
QRP_CLOUDFLARED_SHA256=REPLACE_WITH_64_HEX_RELEASE_SHA256
QRP_CLOUDFLARED_TOKEN_FILE=/home/kayla/.config/cloudflared/qrp-research-web.token
QRP_TUNNEL_PID_FILE=/run/user/1000/qrp-research-web/cloudflared.pid
QRP_TUNNEL_STATUS=/srv/research-lane/ops-logs/qrp-research-web/tunnel-status.json
