[Unit]
Description=Research queue Linux/HK relay
After=network-online.target
Wants=network-online.target
OnFailure=research-queue-alert@relay.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/research-queue/relay-registrar.env
ExecStart=/usr/bin/flock -n %t/research-queue-relay.lock /usr/bin/python3 /srv/research-lane/qrp/code/current/deploy/research-queue/linux/relay-run.py --once
Nice=10
IOSchedulingClass=idle
CPUAffinity=0-7 16-23
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/research-lane/research-queue /srv/research-lane/qrp/var /srv/research-lane/ops-logs/research-queue-relay
StandardOutput=append:/srv/research-lane/ops-logs/research-queue-relay/run.log
StandardError=append:/srv/research-lane/ops-logs/research-queue-relay/error.log
