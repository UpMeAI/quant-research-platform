# AUTONOMOUS_RESEARCH_QUEUE_V1 rev 4 §3.6 (HK agent, oneshot). Reference invocation: the queue consumer (Q1) supplies the per-task in/out names.
# No environment file and no key of any kind; the agent refuses to start if its environment has one (RQ_AGENT_ENV_HAS_KEY).
# No IP at all: the only thing it can reach is the gateway's unix socket.
[Unit]
Description=rq-agent (HK, tool-less DeepSeek agent task)
After=rq-deepseek-gateway.service

[Service]
Type=oneshot
User=rq-agent
Group=rq-agent
Environment=RQ_SPOOL_DIR=/var/lib/rq-spool
ExecStart=/bin/sh /opt/research-queue/current/deploy/research-queue-ai/hk/rq-agent-drain.sh
TimeoutStartSec=1800
Slice=research.slice
MemoryMax=256M
Nice=19
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
TemporaryFileSystem=/var/lib:ro
BindReadOnlyPaths=/var/lib/rq-spool/in
BindPaths=/var/lib/rq-spool/out
ProtectProc=invisible
ProcSubset=pid
