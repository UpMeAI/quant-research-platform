# r2-day-export.env: install as ~/.config/rf1116/r2-day-export.env (the unit's EnvironmentFile). It names the connection only; no credential belongs in it.
# R2EXP_PSQL: the psql command line WITH its connection, run on the V6 host under V6's own existing DB account. It must pass PGOPTIONS through to psql (the script sets
# PGOPTIONS='-c default_transaction_read_only=on'). With the V6 Postgres container: docker exec -i -e PGOPTIONS <v6 postgres container> psql -U <v6 db user> -d <v6 database>
R2EXP_PSQL="docker exec -i -e PGOPTIONS V6_POSTGRES_CONTAINER psql -U V6_DB_USER -d V6_DATABASE"
# R2EXP_DROP_ROOT: the lane's drop directory (the arrival container mounts <root>/<R1|R2> read-only)
R2EXP_DROP_ROOT=/srv/research-lane/rf1116-mining/holdout-daydrop
