# r2-day-export.env: install as ~/.config/rf1116/r2-day-export.env (the unit's EnvironmentFile). It names the connection only; no credential belongs in it.
# The V6 Postgres container, V6's own existing DB user and its database (values from #73's db.runArgv on the Linux host, filled by ops-coord at install; the Mac names are
# ashare-v6-postgres-1 / ashare_v6_restore_20260901). The script reaches them with `docker exec -i -e PGOPTIONS=... <container> sh -c 'psql ...'` and nothing else.
R2EXP_PG_CONTAINER=V6_POSTGRES_CONTAINER
R2EXP_PG_USER=V6_DB_USER
R2EXP_PG_DB=V6_DATABASE
# the lane's drop directory (the arrival container mounts <root>/<R1|R2> read-only)
R2EXP_DROP_ROOT=/srv/research-lane/rf1116-mining/holdout-daydrop
# seconds allowed per psql call (default 600)
R2EXP_TIMEOUT=600
