<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.upmeai.qrp-ai-review-daily</string>
  <key>Disabled</key><true/>
  <key>RunAtLoad</key><false/>
  <key>ProgramArguments</key><array>
    <string>__ABS_CST_GATE__</string>
    <string>--label</string><string>qrp-ai-review-daily</string>
    <string>--at</string><string>22:40</string>
    <string>--late</string><string>60</string>
    <string>--</string><string>__ABS_NODE__</string>
    <string>__ABS_QRP__/apps/research-cli/ai_review_daily.js</string>
    <string>--inbox</string><string>__ABS_DELIVERED_INBOX__</string>
    <string>--desk-root</string><string>__ABS_TRUSTED_DESK__</string>
    <string>--output-root</string><string>__ABS_QRP__/var/ai-review</string>
  </array>
  <key>WorkingDirectory</key><string>__ABS_QRP__</string>
  <key>EnvironmentVariables</key><dict><key>AI_REVIEW_ENABLED</key><string>0</string></dict>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__ABS_QRP__/var/log/ai-review-daily.out.log</string>
  <key>StandardErrorPath</key><string>__ABS_QRP__/var/log/ai-review-daily.err.log</string>
</dict></plist>
