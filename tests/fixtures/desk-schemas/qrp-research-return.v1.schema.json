{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qrp-research-return.v1.schema.json",
  "title": "QRP_RESEARCH_RETURN_V1",
  "description": "Review loop Addendum 6 §5.1: QRP's projection of its own ledgers (adoption decisions, baseline and comparison locks, Desk links) for the desk week file. Producer QRP; the coordinator commits it under docs/review-loop/research-return/ and the next week revision carries it as an input. No new judgement. Addendum 7 §3.3: triage[] -- each candidate's current RESEARCH_TRIAGE_V1 row from QRP var/ledger/research/desk_triage.jsonl. Addendum 8: sealedVerdicts[] -- sealed research conclusions. Addendum 9: optional validated AI review cards and factor ideas, research proposals only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "producer", "generatedAt", "asOf", "sources", "decisions", "questions", "interpretation", "realOrder", "brokerWrite", "hash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "QRP_RESEARCH_RETURN_V1" },
    "producer": { "const": "QRP" },
    "generatedAt": { "$ref": "#/$defs/instant" },
    "asOf": { "$ref": "#/$defs/instant" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ledger", "sha256", "rows"],
        "properties": {
          "ledger": {
            "enum": ["research/adoption_decisions.jsonl", "research/baseline_evaluations.jsonl", "research/comparison_evaluations.jsonl", "runtime-research-loop/links.jsonl", "research/overseas_sealed_verdicts.jsonl", "research/ashare_sealed_verdicts.jsonl"]
          },
          "sha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hex64" }], "description": "null when the ledger file does not exist (rows 0)." },
          "rows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "sealedVerdicts": { "type": "array", "description": "Addendum 8 §1 (optional): sealed research conclusions. They are not Owner decisions (§2), never 等你决定 and never an adoption record.", "items": { "$ref": "#/$defs/sealedVerdict" } },
    "aiReviewCards": { "type": "array", "maxItems": 3, "description": "Addendum 9: at most one validated weekly review card for each market.", "items": { "$ref": "#/$defs/aiReviewCard" } },
    "factorIdeas": { "type": "array", "maxItems": 15, "description": "Addendum 9: validated research proposals, at most five per market card.", "items": { "$ref": "#/$defs/factorIdea" } },
    "triage": {
      "type": "array",
      "description": "Addendum 7 §3.3 (optional): RESEARCH_TRIAGE_V1 rows.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "recordHash", "candidateId", "questionKey", "queueFile", "queueSha256", "outcome", "reasonCode", "questionRef", "strategyRef", "mergedInto", "fixRef", "evidence", "basisZh", "recordedBy", "sessionRef", "at", "supersedes"],
        "properties": {
          "recordId": { "type": "string", "pattern": "^RTR-[0-9a-f]{16}$" },
          "recordHash": { "$ref": "#/$defs/hex64" },
          "candidateId": { "type": "string", "pattern": "^RLC-(CN|US|CRYPTO)-\\d{4}W\\d{2}-[1-9]\\d*$" },
          "questionKey": { "type": "string", "pattern": "^RQK-[0-9a-f]{16}$" },
          "queueFile": { "type": "string", "pattern": "^REVIEW_LOOP_RESEARCH_QUEUE_\\d{4}-W\\d{2}(_R[1-9]\\d*)?\\.json$" },
          "queueSha256": { "$ref": "#/$defs/hex64" },
          "outcome": { "enum": ["OPEN_QUESTION", "FIX", "MERGE", "CLOSE"] },
          "reasonCode": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" },
          "questionRef": { "type": ["string", "null"], "minLength": 1 },
          "strategyRef": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" },
          "mergedInto": { "type": ["string", "null"], "minLength": 1 },
          "fixRef": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["repo", "ref"],
                "properties": { "repo": { "enum": ["Ashare-V6", "smartflow", "portfolio-desk"] }, "ref": { "type": "string", "minLength": 1 } }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "weekId", "file", "hash"],
                  "properties": {
                    "kind": { "const": "SCAN" },
                    "weekId": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
                    "file": { "$ref": "#/$defs/text" },
                    "hash": { "$ref": "#/$defs/hex64" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "file", "hash", "path"],
                  "properties": {
                    "kind": { "const": "FILE" },
                    "file": { "$ref": "#/$defs/text" },
                    "hash": { "$ref": "#/$defs/hex64" },
                    "path": { "$ref": "#/$defs/text" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "repo", "path", "commit", "clause"],
                  "properties": {
                    "kind": { "const": "REPO" },
                    "repo": { "$ref": "#/$defs/text" },
                    "path": { "$ref": "#/$defs/nullableText" },
                    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                    "clause": { "$ref": "#/$defs/nullableText" }
                  }
                }
              ]
            }
          },
          "basisZh": { "$ref": "#/$defs/text" },
          "recordedBy": { "const": "RESEARCH" },
          "sessionRef": { "type": ["string", "null"], "minLength": 1 },
          "at": { "$ref": "#/$defs/instant" },
          "supersedes": { "type": ["string", "null"], "pattern": "^RTR-[0-9a-f]{16}$" }
        }
      }
    },
    "interpretation": { "const": "RESEARCH_RESULTS_AND_OWNER_DECISIONS_NOT_ORDERS" },
    "realOrder": { "const": 0 },
    "brokerWrite": { "const": false },
    "hash": { "$ref": "#/$defs/hex64" }
  },
  "$defs": {
    "aiMarket": { "enum": ["CN_A", "US_EQUITY", "CRYPTO"] },
    "weekId": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
    "aiReviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textZh", "factIds"],
      "properties": {
        "textZh": { "$ref": "#/$defs/text" },
        "factIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "aiQuestionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanismId", "layer", "decisionPoint", "market", "questionZh", "factIds"],
      "properties": {
        "mechanismId": { "$ref": "#/$defs/ref" },
        "layer": { "enum": ["SELECTION_TIMING", "RISK", "ACCOUNT", "NA_EXECUTION"] },
        "decisionPoint": { "enum": ["SELECT", "DIRECTION", "ENTRY", "EXIT", "SIZING", "COST"] },
        "market": { "$ref": "#/$defs/aiMarket" },
        "questionZh": { "$ref": "#/$defs/text" },
        "factIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "aiReviewCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId", "market", "weekId", "cardSha256", "factPackSha256", "modelAlias", "supporting", "opposing", "unknowns", "repeatedPatterns", "questionProposals", "noIdeaReason", "ideaIds"],
      "properties": {
        "cardId": { "$ref": "#/$defs/ref" },
        "market": { "$ref": "#/$defs/aiMarket" },
        "weekId": { "$ref": "#/$defs/weekId" },
        "cardSha256": { "$ref": "#/$defs/hex64" },
        "factPackSha256": { "$ref": "#/$defs/hex64" },
        "modelAlias": { "$ref": "#/$defs/text" },
        "supporting": { "type": "array", "items": { "$ref": "#/$defs/aiReviewItem" } },
        "opposing": { "type": "array", "items": { "$ref": "#/$defs/aiReviewItem" } },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/aiReviewItem" } },
        "repeatedPatterns": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["patternKey", "count", "noteZh", "factIds"],
            "properties": {
              "patternKey": { "$ref": "#/$defs/ref" }, "count": { "type": "integer", "minimum": 1 }, "noteZh": { "$ref": "#/$defs/text" },
              "factIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
            }
          }
        },
        "questionProposals": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/aiQuestionProposal" } },
        "noIdeaReason": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/aiReviewItem" }] },
        "ideaIds": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "factorMechanism": {
      "anyOf": [
        { "$ref": "#/$defs/ref" },
        {
          "type": "object", "additionalProperties": false, "required": ["NEW"],
          "properties": {
            "NEW": {
              "type": "object", "additionalProperties": false, "required": ["proposedId", "titleZh", "descriptionZh", "layer", "decisionPoint"],
              "properties": {
                "proposedId": { "$ref": "#/$defs/ref" }, "titleZh": { "$ref": "#/$defs/text" }, "descriptionZh": { "$ref": "#/$defs/text" },
                "layer": { "const": "SELECTION_TIMING" }, "decisionPoint": { "enum": ["SELECT", "DIRECTION", "ENTRY"] }
              }
            }
          }
        }
      ]
    },
    "factorIdea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ideaId", "market", "weekId", "mechanism", "readings", "holdingPeriods", "questionZh", "expectedFailureZh", "factIds", "cardSha256", "recordHash"],
      "properties": {
        "ideaId": { "type": "string", "pattern": "^FI-(CN_A|US_EQUITY|CRYPTO)-\\d{4}-W\\d{2}-[1-9]\\d*$" },
        "market": { "$ref": "#/$defs/aiMarket" },
        "weekId": { "$ref": "#/$defs/weekId" },
        "mechanism": { "$ref": "#/$defs/factorMechanism" },
        "readings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "pitAvailableAt"],
            "properties": { "id": { "$ref": "#/$defs/ref" }, "pitAvailableAt": { "$ref": "#/$defs/instant" } }
          }
        },
        "holdingPeriods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "questionZh": { "$ref": "#/$defs/text" },
        "expectedFailureZh": { "$ref": "#/$defs/text" },
        "factIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "cardSha256": { "$ref": "#/$defs/hex64" },
        "recordHash": { "$ref": "#/$defs/hex64" }
      }
    },
    "sealedVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "market", "book", "verdict", "verdictState", "resultFile", "sha256", "commit", "sealedAt", "origin", "deskLink"],
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "market": { "enum": ["CN", "US", "CRYPTO"] },
        "book": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "verdict": { "enum": ["做", "不做"] },
        "verdictState": { "$ref": "#/$defs/text", "description": "The research's own state, kept so the strength of evidence stays visible (Addendum 8 §2.3)." },
        "resultFile": { "$ref": "#/$defs/text" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "commit": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{40}$" }], "description": "null only for a file that is not in git (under artifacts/coordinator/)." },
        "sealedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The sealing day, CST." },
        "origin": { "enum": ["REVIEW_CANDIDATE", "QRP_PROGRAM"] },
        "deskLink": { "$ref": "#/$defs/deskLink" }
      }
    },
    "instant": { "type": "string", "format": "date-time" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1 },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$" },
    "deskLink": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateId", "questionKey", "linkId"],
          "properties": {
            "candidateId": { "type": "string", "pattern": "^RLC-(CN|US|CRYPTO)-\\d{4}W\\d{2}-[1-9]\\d*$" },
            "questionKey": { "type": "string", "pattern": "^RQK-[0-9a-f]{16}$" },
            "linkId": { "$ref": "#/$defs/ref" }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "recordHash", "kind", "strategyRef", "caseRef", "questionRef", "questionTitleZh", "resultId", "part", "lock", "decision", "recommendation", "recommendationReasonZh", "ownerWords", "decidedAt", "followUpZh", "deskLink", "origin"],
      "properties": {
        "recordId": { "$ref": "#/$defs/ref" },
        "recordHash": { "$ref": "#/$defs/hex64" },
        "kind": { "enum": ["DECISION", "RECOMMENDATION"] },
        "strategyRef": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "caseRef": { "$ref": "#/$defs/ref" },
        "questionRef": { "$ref": "#/$defs/ref" },
        "questionTitleZh": { "$ref": "#/$defs/nullableText" },
        "resultId": { "$ref": "#/$defs/ref" },
        "part": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "verdictState", "fileSha256", "lockedAt", "k2Ref"],
          "properties": {
            "class": { "enum": ["BASELINE", "COMPARISON"] },
            "verdictState": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "fileSha256": { "$ref": "#/$defs/hex64" },
            "lockedAt": { "$ref": "#/$defs/instant" },
            "k2Ref": { "$ref": "#/$defs/nullableText" }
          }
        },
        "decision": { "enum": [null, "ADOPT", "NOT_ADOPTED", "NOT_APPLICABLE"] },
        "recommendation": { "enum": [null, "ADOPT", "NOT_ADOPTED"] },
        "recommendationReasonZh": { "$ref": "#/$defs/nullableText" },
        "ownerWords": { "$ref": "#/$defs/nullableText" },
        "decidedAt": { "type": ["string", "null"], "format": "date-time" },
        "followUpZh": { "$ref": "#/$defs/nullableText" },
        "deskLink": { "$ref": "#/$defs/deskLink" },
        "origin": { "enum": ["DESK_REVIEW", "QRP_PROGRAM"] }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyRef", "questionRef", "titleZh", "stateZh", "k2FrozenAt", "expectedResultDate", "deskLink", "origin"],
      "properties": {
        "strategyRef": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "questionRef": { "$ref": "#/$defs/ref" },
        "titleZh": { "$ref": "#/$defs/text" },
        "stateZh": { "$ref": "#/$defs/text" },
        "k2FrozenAt": { "type": ["string", "null"], "format": "date-time" },
        "expectedResultDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "deskLink": { "$ref": "#/$defs/deskLink" },
        "origin": { "enum": ["DESK_REVIEW", "QRP_PROGRAM"] }
      }
    }
  }
}
