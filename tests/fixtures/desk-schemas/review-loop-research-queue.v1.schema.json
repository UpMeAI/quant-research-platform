{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-loop-research-queue.v1.schema.json",
  "title": "REVIEW_LOOP_RESEARCH_QUEUE_V1",
  "description": "Review loop Addendum 6 §4.1: the desk's research questions for QRP, one snapshot per week revision (every unconcluded research candidate, and those concluded in the last 8 weeks). Producer COORDINATOR; compiled with the week file of the same revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "producer", "weekId", "revision", "generatedAt", "sourceWeek", "routes", "entries", "interpretation", "realOrder", "brokerWrite", "hash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "REVIEW_LOOP_RESEARCH_QUEUE_V1" },
    "producer": { "const": "COORDINATOR" },
    "weekId": { "$ref": "#/$defs/weekId" },
    "revision": { "type": "integer", "minimum": 0 },
    "generatedAt": { "$ref": "#/$defs/instant" },
    "sourceWeek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "hash"],
      "properties": {
        "file": { "type": "string", "pattern": "^REVIEW_LOOP_WEEK_\\d{4}-W\\d{2}(_R[1-9]\\d*)?\\.json$" },
        "sha256": { "$ref": "#/$defs/hex64", "description": "sha256 of the week file's bytes." },
        "hash": { "$ref": "#/$defs/hex64", "description": "The week payload's own hash field." }
      }
    },
    "routes": { "const": "REVIEW_LOOP_DEFAULT_ROUTES@v1" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "interpretation": { "const": "RESEARCH_INTAKE_FACTS_NOT_ORDERS" },
    "realOrder": { "const": 0 },
    "brokerWrite": { "const": false },
    "hash": { "$ref": "#/$defs/hex64" }
  },
  "$defs": {
    "instant": { "type": "string", "format": "date-time" },
    "weekId": { "type": "string", "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1 },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "candidateId": { "type": "string", "pattern": "^RLC-(CN|US|CRYPTO)-\\d{4}W\\d{2}-[1-9]\\d*$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "file", "hash", "path"],
      "properties": {
        "contract": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "file": { "$ref": "#/$defs/text" },
        "hash": { "$ref": "#/$defs/hex64" },
        "path": { "$ref": "#/$defs/text" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionKey", "candidateId", "market", "ledgerId", "roleId", "triggerIds", "findings", "firstWeek", "weeksSeen", "candidateType",
        "ruleRef", "versionSegmentId", "effect", "sample", "questionZh", "ownerPick", "deskState", "mergedInto", "qrpHint"],
      "properties": {
        "questionKey": { "type": "string", "pattern": "^RQK-[0-9a-f]{16}$", "description": "Addendum 6 §3.3: one key per question across weeks." },
        "candidateId": { "$ref": "#/$defs/candidateId" },
        "market": { "enum": ["CN", "US", "CRYPTO"] },
        "ledgerId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "= QRP strategy_ref." },
        "roleId": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" },
        "triggerIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^F\\d{2}$" } },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["findingId", "weekId", "triggerId", "fact", "evidence"],
            "properties": {
              "findingId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Za-z0-9_.:\\-]+$" },
              "weekId": { "$ref": "#/$defs/weekId" },
              "triggerId": { "type": "string", "pattern": "^F\\d{2}$" },
              "fact": { "$ref": "#/$defs/text" },
              "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
            }
          }
        },
        "firstWeek": { "$ref": "#/$defs/weekId" },
        "weeksSeen": { "type": "integer", "minimum": 1 },
        "candidateType": { "enum": ["PARAMETER", "RULE"] },
        "ruleRef": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "effectiveFrom", "source"],
            "properties": {
              "ref": { "type": "string", "pattern": "^[A-Za-z0-9_.:\\-]+@[A-Za-z0-9_.:\\-]+$" },
              "effectiveFrom": { "type": "string", "minLength": 10 },
              "source": { "enum": ["S17", "V6_RECORD", "ACCEPTANCE"] }
            }
          }
        },
        "versionSegmentId": { "type": ["string", "null"] },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "basis", "state", "reasonCode"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "unit": { "enum": ["R", "CNY", "USD", "USDT"] },
            "basis": { "$ref": "#/$defs/text" },
            "state": { "enum": ["MEASURED", "MODELLED", "NOT_MEASURED"] },
            "reasonCode": { "type": ["string", "null"] }
          }
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n", "unit", "floor", "state"],
          "properties": {
            "n": { "type": "integer", "minimum": 0 },
            "unit": { "enum": ["CLOSED_TRADES", "SESSIONS", "EVENTS"] },
            "floor": { "type": "integer", "minimum": 1 },
            "state": { "enum": ["AT_OR_ABOVE_FLOOR", "BELOW_FLOOR"] }
          }
        },
        "questionZh": { "$ref": "#/$defs/text" },
        "ownerPick": {
          "type": "object",
          "additionalProperties": false,
          "required": ["choice", "ownerWords", "at", "weekId", "revision"],
          "properties": {
            "choice": { "enum": [null, "RESEARCH", "MERGE", "DONT", "LATER"], "description": "null = not picked yet (待 Owner 挑选)." },
            "ownerWords": { "$ref": "#/$defs/nullableText" },
            "at": { "type": ["string", "null"], "format": "date-time" },
            "weekId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/weekId" }] },
            "revision": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "deskState": { "enum": ["OPEN", "PICKED", "RESEARCH_DRAFTED", "RESEARCH_SIGNED", "RESULT", "DO", "DONT", "DEPLOYED", "MEASURING", "NOT_PICKED", "MERGED"] },
        "mergedInto": { "$ref": "#/$defs/nullableText" },
        "qrpHint": { "$ref": "#/$defs/nullableText", "description": "A possible QRP question to merge into, for the Owner to read; never a merge." }
      }
    }
  }
}
